{
  "name": "gorex",
  "version": "3.0.0",
  "description": "Gorex - FFmpeg / yt-dlp GUI with Tauri + Vite + React",
  "main": "./out/main/index.js",
  "author": "Akhmatyarov",
  "scripts": {
    "dev:web": "vite --host 127.0.0.1 --port 1420",
    "build:web": "vite build",
    "prepare:tauri-binaries": "node scripts/prepare-tauri-binaries.mjs",
    "typecheck": "tsc --noEmit",
    "dev:tauri": "tauri dev",
    "build:tauri": "tauri build",
    "dev": "tauri dev",
    "build": "tauri build --no-bundle",
    "preview": "vite preview",
    "pack": "tauri build --no-bundle",
    "pack:mac": "tauri build --bundles app",
    "dist": "tauri build",
    "dist:mac": "tauri build --bundles app,dmg",
    "dist:win": "tauri build --bundles nsis",
    "installer-assets": "node build/create-installer-bitmaps.js",
    "dev:electron": "electron-vite dev --watch",
    "build:electron": "electron-vite build",
    "preview:electron": "electron-vite preview",
    "pack:electron": "electron-vite build && electron-builder --dir",
    "pack:mac:electron": "electron-vite build && electron-builder --mac --arm64 --dir",
    "predist:electron": "node build/create-installer-bitmaps.js",
    "dist:electron": "electron-vite build && electron-builder",
    "dist:mac:electron": "electron-vite build && electron-builder --mac dmg zip --arm64",
    "dist:win:electron": "electron-vite build && electron-builder --win nsis --x64",
    "make-installer:electron": "node build/make-installer.js",
    "installer:start:electron": "cd installer && electron ."
  },
  "dependencies": {
    "@derhuerst/ffprobe-static": "5.3.0",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@tauri-apps/api": "2.11.1",
    "bootstrap-icons": "^1.13.1",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "7zip-bin": "^5.2.0",
    "electron": "^35.7.5",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.0.1",
    "sass": "^1.97.3",
    "typescript": "^7.0.2",
    "vite": "^6.4.3"
  },
  "build": {
    "appId": "com.akhmatyarov.gorex",
    "productName": "Gorex",
    "icon": "resources/icon.png",
    "asarUnpack": [
      "node_modules/@derhuerst/ffprobe-static/**",
      "node_modules/ffmpeg-static/**"
    ],
    "files": [
      "out/**",
      "resources/icon.png",
      "resources/Mac/16.png",
      "!installer/**",
      "!dist/**",
      "!build/**",
      "!Downloads_Temp/**",
      "!others/**"
    ],
    "win": {
      "target": "nsis",
      "extraFiles": [
        {
          "from": "resources/ytdl",
          "to": "resources/ytdl",
          "filter": [
            "**/*",
            "!yt-dlp_macos"
          ]
        },
        {
          "from": "resources/twitch",
          "to": "resources/twitch"
        }
      ]
    },
    "mac": {
      "icon": "resources/Mac/Gorex.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "minimumSystemVersion": "11.0.0",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-${version}-macOS-${arch}.${ext}",
      "extraResources": [
        {
          "from": "resources/ytdl/yt-dlp_macos",
          "to": "ytdl/yt-dlp_macos"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
