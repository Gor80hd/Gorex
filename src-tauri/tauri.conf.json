{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Gorex",
  "version": "3.0.0",
  "identifier": "com.akhmatyarov.gorex",
  "build": {
    "frontendDist": "../dist-tauri-frontend",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "title": "Gorex",
        "width": 1280,
        "height": 850,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: http://127.0.0.1:*; frame-src http://127.0.0.1:* https://www.youtube.com https://www.youtube-nocookie.com; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "binaries/": "binaries/",
      "../LICENSE": "licenses/LICENSE",
      "../COPYING": "licenses/COPYING",
      "../licenses/GPL-3.0.txt": "licenses/GPL-3.0.txt",
      "../licenses/FFmpeg-builds.md": "licenses/FFmpeg-builds.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Russian"],
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
